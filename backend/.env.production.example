# Parenthèse, API en production sans Docker (PM2 + nginx, voir deploy/).
# Copiez ce fichier en backend/.env sur le serveur et remplacez chaque valeur d'exemple.
# Pour une installation Docker, utilisez plutôt le .env.example à la racine du dépôt.

NODE_ENV=production
PORT=4000

# Base PostgreSQL dédiée. L'API refuse de démarrer en production avec l'URL de développement.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/parenthese"

# 16 caractères minimum. Générer avec : openssl rand -base64 48
JWT_SECRET=""
# Durée de vie des sessions (compte) et des accès par lien partagé.
JWT_EXPIRES_IN="7d"
JWT_TREE_ACCESS_EXPIRES_IN="24h"

# Adresses autorisées à appeler l'API, sans slash final, séparées par des virgules.
CORS_ORIGIN="https://arbre.example.org"

# Dossier des médias envoyés. Un chemin relatif part du dossier backend/.
MEDIA_STORAGE_PATH="/var/lib/parenthese/media"
